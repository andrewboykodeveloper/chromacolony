:root {
    --night: #0e1838;
    --gold: #ffc83d;
    --accent: #d85f4c;
    --accent-text: #ffffff;
    --text: #e0e2f0;
    --pill: rgba(14, 24, 56, 0.92);
    --scrim: rgba(6, 10, 26, 0.72);
    --off: #34467a;
}

.root {
    flex-grow: 1;
    -unity-font-definition: url("Fonts/Inter-Regular.ttf");
    color: var(--text);
}

.safe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.screen {
    flex-grow: 1;
}

.hidden {
    display: none;
}

.title {
    position: absolute;
    top: 19%;
    left: 0;
    right: 0;
    margin: 0;
    font-size: 108px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #ffffff;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(11, 20, 51, 0.9);
    text-shadow: 0 6px 14px rgba(4, 8, 24, 0.75);
}

.menu .btn {
    position: absolute;
    top: 63%;
    left: 50%;
    min-width: 840px;
    margin-left: -420px;
}

.btn {
    min-width: 720px;
    height: 148px;
    padding: 0 40px;
    border-width: 0;
    font-size: 54px;
    -unity-font-style: bold;
    color: #ffffff;
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 150;
    -unity-slice-right: 150;
    -unity-slice-top: 140;
    -unity-slice-bottom: 140;
    -unity-slice-scale: 2.5;
    transition-property: scale;
    transition-duration: 0.12s;
}

.btn:active {
    scale: 0.96;
}

.btn-primary {
    background-image: url("../Art/Sprites/button-primary.png");
    text-shadow: 0 3px 4px rgba(110, 28, 18, 0.65);
}

.btn-secondary {
    margin-top: 28px;
    background-image: url("../Art/Sprites/button-secondary.png");
    text-shadow: 0 3px 4px rgba(8, 20, 60, 0.65);
}

.dialog-card .btn {
    margin-top: 28px;
    min-width: 780px;
    padding-left: 104px;
    padding-right: 64px;
}

.glyph {
    position: absolute;
    left: 40px;
    top: 36px;
    width: 76px;
    height: 76px;
    -unity-background-scale-mode: scale-to-fit;
}

.glyph-next {
    background-image: url("../Art/Sprites/icon-next.png");
}

.glyph-retry {
    background-image: url("../Art/Sprites/icon-retry.png");
}

.glyph-menu {
    background-image: url("../Art/Sprites/icon-menu.png");
}

.glyph-helper {
    background-image: url("../Art/Sprites/sparkle.png");
}

.glyph-coin {
    background-image: url("../Art/Sprites/coin.png");
}

.glyph-settings {
    background-image: url("../Art/Sprites/icon-settings.png");
}

.menu-top {
    width: 100%;
    max-width: 1080px;
    align-self: center;
    flex-direction: row;
    justify-content: flex-end;
    padding: 36px;
}

.menu-settings {
    background-image: url("../Art/Sprites/icon-settings.png");
}

.setting {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 26px;
}

.setting-name {
    font-size: 50px;
    color: var(--text);
}

.choice {
    flex-direction: row;
}

.choice-option {
    height: 92px;
    margin: 0 0 0 12px;
    padding: 0 34px;
    border-width: 0;
    border-radius: 46px;
    background-color: var(--off);
    font-size: 42px;
    -unity-font-style: bold;
    color: var(--text);
}

.choice-option.on {
    background-color: var(--accent);
    color: var(--accent-text);
}

.switch {
    width: 168px;
    height: 92px;
    margin: 0;
    padding: 8px;
    border-width: 0;
    border-radius: 46px;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    background-color: var(--off);
}

.switch.on {
    justify-content: flex-end;
    background-color: var(--accent);
}

.switch-knob {
    width: 76px;
    height: 76px;
    border-radius: 38px;
    background-color: #ffffff;
}

#settings {
    padding-top: 220px;
}

.dialog-card .settings-done {
    margin-top: 48px;
    padding-left: 64px;
}

.btn-icon {
    width: 132px;
    height: 132px;
    border-width: 0;
    border-radius: 66px;
    background-color: var(--night);
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.12s;
}

.btn-icon:active {
    scale: 0.92;
}

.btn-icon.on {
    background-color: var(--accent);
}

.hud-pause {
    background-image: url("../Art/Sprites/icon-pause.png");
}

.hud-speed {
    background-image: url("../Art/Sprites/icon-speed.png");
}

.game {
    padding: 36px;
    width: 100%;
    max-width: 1080px;
    align-self: center;
}

.hud {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.coins {
    flex-direction: row;
    align-items: center;
    padding: 14px 32px 14px 18px;
}

.coins.pill {
    padding-top: 18px;
    padding-bottom: 18px;
}

.coin-icon {
    width: 64px;
    height: 64px;
    margin-right: 12px;
    background-image: url("../Art/Sprites/coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

.coins-count {
    font-size: 46px;
    -unity-font-style: bold;
    color: var(--gold);
}

.spacer {
    flex-grow: 1;
}

.hint {
    align-self: center;
    max-width: 860px;
    margin-bottom: 14px;
    padding: 12px 32px;
    border-radius: 36px;
    background-color: var(--pill);
    font-size: 38px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--text);
}

.helpers {
    flex-direction: row;
    justify-content: space-around;
}

.helper {
    width: 150px;
    height: 150px;
    border-width: 0;
    border-radius: 75px;
    background-color: var(--pill);
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, opacity;
    transition-duration: 0.12s;
}

.helper:active {
    scale: 0.92;
}

.helper.off {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.5);
}

.helper.off .badge {
    background-color: #5d6488;
    color: #dfe1f2;
}

.helper.on {
    background-color: var(--accent);
}

.helper-slot {
    background-image: url("../Art/Sprites/icon-slot.png");
}

.helper-shuffle {
    background-image: url("../Art/Sprites/icon-shuffle.png");
}

.helper-back {
    background-image: url("../Art/Sprites/icon-back.png");
}

.badge {
    position: absolute;
    right: -10px;
    top: -10px;
    min-width: 66px;
    height: 66px;
    padding: 0 12px;
    border-radius: 33px;
    background-color: var(--accent);
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--accent-text);
}

.badge.price {
    background-color: var(--gold);
    color: var(--night);
}

.dialog-text {
    width: 100%;
    font-size: 44px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
    color: var(--text);
}

.labels {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.crew-count {
    position: absolute;
    width: 160px;
    height: 80px;
    margin-left: -80px;
    margin-top: -40px;
    font-size: 54px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--text);
    text-shadow: 0 3px 6px var(--scrim);
}

.crew-more {
    position: absolute;
    min-width: 58px;
    height: 46px;
    padding: 0 12px;
    translate: -50% -50%;
    border-radius: 23px;
    background-color: var(--pill);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #ffffff;
}

.flying-coin {
    position: absolute;
    width: 84px;
    height: 84px;
    margin-left: -42px;
    margin-top: -42px;
    background-image: url("../Art/Sprites/coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

.pill {
    padding: 22px 40px;
    border-radius: 48px;
    background-color: var(--pill);
    font-size: 46px;
    color: var(--text);
}

.dialog {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--scrim);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.dialog.open {
    opacity: 1;
}

.dialog.won {
    justify-content: flex-end;
    padding-bottom: 250px;
    background-color: rgba(6, 10, 26, 0.25);
}

#result .dialog-title {
    font-size: 62px;
}

.dialog-card {
    width: 900px;
    align-items: center;
    padding: 76px 56px 72px 56px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Art/Sprites/panel.png");
    -unity-slice-left: 120;
    -unity-slice-right: 120;
    -unity-slice-top: 120;
    -unity-slice-bottom: 120;
    -unity-slice-scale: 3;
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.5));
}

.dialog-card .btn {
    filter: none;
}

.dialog-title {
    width: 100%;
    font-size: 76px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 40px;
    color: var(--text);
}
